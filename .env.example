HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./local-data/workwork.sqlite
NODE_ENV=development
# Leave forwarding-header trust disabled unless the proxy chain is verified.
TRUST_PROXY_HOPS=0
# Railway: set APP_ORIGIN to the generated https URL, with no trailing slash.
# APP_ORIGIN=https://your-new-service.up.railway.app

# Optional. With rules mode, no work data is sent to an AI provider.
WORKWORK_AI_MODE=rules
# To enable language-model extraction set WORKWORK_AI_MODE=openai and supply
# a NEW project API key only via Railway Variables or an untracked .env file.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
